{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React TypeScript Configuration",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
