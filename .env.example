# Root env example
# Copy app-specific examples instead of committing real env files.

# Workers secrets (Cloudflare: wrangler secret put <KEY>)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
CLERK_SECRET_KEY=sk_test_xxx
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk_xxx
AI_DEFAULT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
# AI_IMAGE_MODE=tool -> text model uses analyze_image tool; native -> model receives image directly
AI_IMAGE_MODE=tool

# --- Plan subscription / token limits (all optional, defaults apply) ---
# Free plan: 200K tokens/month, 10 iterations/run
PLAN_FREE_MONTHLY_TOKENS=200000
PLAN_FREE_MAX_ITERATIONS=10
PLAN_FREE_REQ_PER_MINUTE=10
# Pro plan (codebase-only for now): 2M tokens/month, 30 iterations/run
PLAN_PRO_MONTHLY_TOKENS=2000000
PLAN_PRO_MAX_ITERATIONS=30
PLAN_PRO_REQ_PER_MINUTE=60
# Pro gateway is CODEBASE-ONLY for now: no upgrade endpoint is registered and
# no user can self-grant. Plan switching happens directly in the DB until payments land.

# Web/Admin public env
VITE_API_URL=http://localhost:8787
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
