# Root env example
# Copy app-specific examples instead of committing real env files.

# Workers secrets (Cloudflare: wrangler secret put <KEY>)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
CLERK_SECRET_KEY=sk_test_xxx
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=sk_xxx
AI_DEFAULT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
# tool = default: text model uses analyze_image tool; native = selected/default model receives image directly and image tool is disabled.
AI_IMAGE_MODE=tool

# Web/Admin public env
VITE_API_URL=http://localhost:8787
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
